{
  "name": "vitorsreis/sift",
  "description": "Agent tooling and skills layer for PHP projects.",
  "keywords": [
    "php",
    "agent",
    "ai",
    "cli",
    "tooling",
    "skills"
  ],
  "type": "composer-plugin",
  "license": "MIT",
  "support": {
    "source": "https://github.com/vitorsreis/sift",
    "issues": "https://github.com/vitorsreis/sift/issues"
  },
  "require": {
    "composer-plugin-api": "^2.6",
    "php": "^8.3",
    "ext-json": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "brianium/paratest": "^7.20",
    "carthage-software/mago": "^1.29",
    "composer/composer": "^2.10",
    "deptrac/deptrac": "^4.6",
    "friendsofphp/php-cs-fixer": "^3.95",
    "icanhazstring/composer-unused": "^0.9.6",
    "infection/infection": "^0.33.2",
    "laravel/pint": "^1.29",
    "maglnet/composer-require-checker": "^4.20",
    "pestphp/pest": "^4.7",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.4",
    "squizlabs/php_codesniffer": "^4.0",
    "vimeo/psalm": "^6.5"
  },
  "autoload": {
    "psr-4": {
      "Sift\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/sift"
  ],
  "extra": {
    "class": "Sift\\Composer\\SiftPlugin"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": false,
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "sift": "@php bin/sift -- @additional_args",
    "composer:validate": "@sift composer validate --strict",
    "test": "@sift pest --parallel",
    "test:coverage": "@sift -dzend_extension=xdebug -dxdebug.mode=coverage pest --coverage --min=80",
    "analyse": "@sift phpstan analyse --memory-limit=1G",
    "format": "@sift pint --test src tests bin/sift bin/phar resources/box.stub.php rector.php",
    "rector": "@sift rector process --dry-run",
    "quality": [
      "@composer:validate",
      "@test",
      "@analyse",
      "@format",
      "@rector"
    ],
    "quality:raw": [
      "@php vendor/bin/composer validate --strict",
      "@php vendor/bin/pest --parallel",
      "@php vendor/bin/phpstan analyse --memory-limit=1G",
      "@php vendor/bin/pint --test src tests bin/sift bin/phar resources/box.stub.php rector.php",
      "@php vendor/bin/rector process --dry-run"
    ],
    "build:phar": "@php -dphar.readonly=0 bin/phar"
  }
}
